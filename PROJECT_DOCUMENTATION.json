  "risk_assessment": {
    "description": "Predictions include risk levels based on probability thresholds",
    "levels": {
      "Low": {
        "threshold": "probability < 0.30",
        "interpretation": "Likely legitimate",
        "recommended_action": "Allow with standard monitoring"
      },
      "Medium": {
        "threshold": "0.30 ≤ probability < 0.70",
        "interpretation": "Suspicious, requires investigation",
        "recommended_action": "Flag for review, request additional verification"
      },
      "High": {
        "threshold": "probability ≥ 0.70",
        "interpretation": "Likely fraud/phishing",
        "recommended_action": "Block transaction or warn user prominently"
      }
    },
    "disclaimer": "This prediction is a risk assessment, not proof of fraud. Human review is recommended for high-stakes decisions."
  },

  "api_endpoints": {
    "base_url": "http://127.0.0.1:8000/api/v1",
    
    "endpoints": [
      {
        "path": "/health",
        "method": "GET",
        "description": "Health check and model status",
        "response": {
          "status": "ok",
          "models": {
            "fraud": {"state": "ready", "selected_model": "..."},
            "phishing": {"state": "ready", "selected_model": "..."}
          }
        }
      },
      {
        "path": "/datasets",
        "method": "GET",
        "description": "List available datasets",
        "response": {
          "items": ["array of dataset summaries"]
        }
      },
      {
        "path": "/datasets/{dataset_id}/summary",
        "method": "GET",
        "description": "Get detailed dataset information",
        "parameters": {
          "dataset_id": "e.g., 'creditcard.csv' or 'phishing_links_url/Dataset.csv'"
        }
      },
      {
        "path": "/models/train",
        "method": "POST",
        "description": "Train models on specified dataset",
        "body": {
          "dataset_id": "creditcard.csv"
        },
        "note": "Task (fraud/phishing) is auto-detected from dataset name"
      },
      {
        "path": "/models/status",
        "method": "GET",
        "description": "Get training status for all models",
        "response": {
          "fraud": {"state": "ready|training|error", "details": "..."},
          "phishing": {"state": "ready|training|error", "details": "..."}
        }
      },
      {
        "path": "/models/evaluation",
        "method": "GET",
        "description": "Get model evaluation metrics",
        "parameters": {
          "task": "fraud or phishing (default: fraud)"
        },
        "response": {
          "selected_model": "...",
          "models": {"model_name": {"accuracy": 0.0, "other_metrics": "..."}}
        }
      },
      {
        "path": "/predict/transaction",
        "method": "POST",
        "description": "Predict transaction fraud",
        "body": {
          "data": {"type": "PAYMENT", "amount": 0, "oldbalanceOrg": 0, "newbalanceOrig": 0, "oldbalanceDest": 0, "newbalanceDest": 0}
        },
        "response": {
          "prediction": "Fraud|Legitimate",
          "is_fraud": "0|1",
          "fraud_probability": 0.0,
          "risk_level": "Low|Medium|High",
          "model_version": "...",
          "prediction_id": 123,
          "created_at": "ISO timestamp"
        }
      },
      {
        "path": "/predict/phishing",
        "method": "POST",
        "description": "Predict phishing URL",
        "body": {
          "data": {"url_len": 0, "dom_len": 0, "is_ip": 0, "query_len": 0}
        },
        "response": "Same structure as /predict/transaction"
      },
      {
        "path": "/predictions",
        "method": "GET",
        "description": "Get paginated prediction history",
        "parameters": {
          "page": "integer (default: 1)",
          "page_size": "integer (default: 20, max: 100)"
        }
      },
      {
        "path": "/predictions/{id}",
        "method": "GET",
        "description": "Get details of specific prediction"
      },
      {
        "path": "/predictions/{id}",
        "method": "DELETE",
        "description": "Delete a prediction from history"
      },
      {
        "path": "/analysis/dashboard",
        "method": "GET",
        "description": "Get dashboard data (dataset info, model status, recent predictions)"
      }
    ]
  },

