  "system_architecture": {
    "overview": "Full-stack web application with FastAPI backend, vanilla JavaScript frontend, and SQLite database for prediction history",
    "components": {
      "frontend": {
        "technology": "HTML5, CSS3, Vanilla JavaScript",
        "framework": "None (Lightweight, no dependencies)",
        "pages": [
          {
            "name": "Dashboard",
            "path": "index.html",
            "purpose": "Overview of datasets, model status, and recent predictions"
          },
          {
            "name": "Analyze",
            "path": "pages/analyze.html",
            "purpose": "Real-time fraud and phishing prediction interface"
          },
          {
            "name": "Datasets",
            "path": "pages/datasets.html",
            "purpose": "Dataset exploration and model training triggers"
          },
          {
            "name": "Evaluation",
            "path": "pages/evaluation.html",
            "purpose": "Model performance metrics and comparison"
          },
          {
            "name": "History",
            "path": "pages/history.html",
            "purpose": "Browse and manage past predictions"
          }
        ],
        "features": [
          "Dynamic form generation based on model features",
          "Real-time risk assessment visualization",
          "Task switching between fraud and phishing detection",
          "Model training progress tracking",
          "Prediction history management"
        ]
      },
      "backend": {
        "technology": "Python 3.x",
        "framework": "FastAPI",
        "server": "Uvicorn ASGI server",
        "structure": {
          "main_app": "backend/app/main.py",
          "services": [
            {
              "name": "dataset_service.py",
              "responsibilities": [
                "Load and validate datasets",
                "Generate dataset summaries",
                "Detect target columns automatically",
                "Handle multiple dataset formats"
              ]
            },
            {
              "name": "training_service.py",
              "responsibilities": [
                "Train multiple ML models in parallel",
                "Automatic feature engineering",
                "Model evaluation and selection",
                "Artifact and metadata management",
                "Support both fraud and phishing tasks"
              ]
            },
            {
              "name": "prediction_service.py",
              "responsibilities": [
                "Load trained models",
                "Validate input features",
                "Generate predictions with probabilities",
                "Risk level assignment",
                "Prediction history persistence"
              ]
            }
          ]
        },
        "database": {
          "type": "SQLite",
          "file": "app.db",
          "tables": {
            "predictions": {
              "columns": [
                "id (INTEGER PRIMARY KEY)",
                "created_at (TEXT)",
                "payload (TEXT/JSON)",
                "result (TEXT/JSON)"
              ],
              "purpose": "Store all predictions for history and audit trail"
            }
          }
        }
      }
    }
  },

  "machine_learning_pipeline": {
    "overview": "Multi-model ensemble approach with automatic model selection based on performance metrics",
    
    "data_preprocessing": {
      "steps": [
        {
          "step": 1,
          "name": "Data Loading",
          "description": "Load CSV datasets using pandas",
          "operations": [
            "Read dataset from filesystem",
            "Detect encoding automatically",
            "Handle missing values"
          ]
        },
        {
          "step": 2,
          "name": "Duplicate Removal",
          "description": "Remove duplicate rows to prevent data leakage",
          "operations": [
            "Identify duplicate records",
            "Keep first occurrence",
            "Reset index after removal"
          ]
        },
        {
          "step": 3,
          "name": "Target Identification",
          "description": "Automatically detect the target column",
          "logic": "Look for columns named: Class, label, fraud, is_fraud, target (case-insensitive)"
        },
        {
          "step": 4,
          "name": "Feature Selection",
          "description": "For phishing task, select only numeric features (URL statistics)",
          "reason": "Raw URL strings are excluded; only engineered numeric features are used"
        },
        {
          "step": 5,
          "name": "Feature Type Detection",
          "description": "Separate features into numeric and categorical",
          "numeric_features": "Continuous and discrete numerical values",
          "categorical_features": "Text labels and categories"
        },
        {
          "step": 6,
          "name": "Train-Test Split",
          "method": "sklearn.train_test_split",
          "parameters": {
            "test_size": 0.2,
            "random_state": 42,
            "stratify": "target variable (preserves class distribution)"
          }
        }
      ],
      
      "preprocessing_pipeline": {
        "name": "ColumnTransformer",
        "numeric_transformer": {
          "steps": [
            {
              "name": "SimpleImputer",
              "strategy": "median",
              "purpose": "Handle missing values in numeric features"
            },
            {
              "name": "StandardScaler",
              "purpose": "Normalize features to mean=0, std=1",
              "reason": "Improves convergence for gradient-based algorithms"
            }
          ]
        },
        "categorical_transformer": {
          "steps": [
            {
              "name": "SimpleImputer",
              "strategy": "most_frequent",
              "purpose": "Handle missing values in categorical features"
            },
            {
              "name": "OneHotEncoder",
              "parameters": {
                "handle_unknown": "ignore"
              },
              "purpose": "Convert categorical variables to binary vectors"
            }
          ]
        }
      }
    },

    "algorithms": {
      "overview": "Three complementary algorithms are trained for each task, and the best performer is automatically selected",
      
      "models": [
        {
          "name": "Logistic Regression",
          "type": "Linear classifier",
          "sklearn_class": "LogisticRegression",
          "hyperparameters": {
            "max_iter": 300,
            "class_weight": "balanced",
            "solver": "liblinear"
          },
          "strengths": [
            "Fast training and prediction",
            "Interpretable coefficients",
            "Probabilistic outputs",
            "Works well with linearly separable data"
          ],
          "weaknesses": [
            "Assumes linear decision boundary",
            "May underfit complex patterns"
          ],
          "use_case": "Baseline model, good for simple patterns",
          "algorithm_details": {
            "principle": "Logistic function (sigmoid) maps linear combination of features to probability",
            "formula": "P(y=1|X) = 1 / (1 + e^(-w·X + b))",
            "optimization": "Minimizes log loss using gradient descent",
            "decision_boundary": "Linear hyperplane in feature space"
          }
        },
        {
          "name": "Decision Tree",
          "type": "Non-linear classifier",
          "sklearn_class": "DecisionTreeClassifier",
          "hyperparameters": {
            "max_depth": 12,
            "class_weight": "balanced",
            "random_state": 42
          },
          "strengths": [
            "Captures non-linear relationships",
            "No feature scaling needed",
            "Handles mixed data types naturally",
            "Interpretable decision rules"
          ],
          "weaknesses": [
            "Prone to overfitting without depth limits",
            "Can be unstable (high variance)"
          ],
          "use_case": "Captures complex interactions between features",
          "algorithm_details": {
            "principle": "Recursively partition feature space using binary splits",
            "splitting_criterion": "Gini impurity or entropy",
            "gini_formula": "Gini = 1 - Σ(p_i²) where p_i is class probability",
            "tree_construction": [
              "Select feature and threshold that maximizes information gain",
              "Split node into two children",
              "Repeat recursively until max_depth or purity reached",
              "Leaf nodes predict majority class"
            ],
            "pruning": "Max depth constraint prevents overfitting"
          }
        },
        {
          "name": "Random Forest",
          "type": "Ensemble classifier (bagging)",
          "sklearn_class": "RandomForestClassifier",
          "hyperparameters": {
            "n_estimators": 120,
            "max_depth": 18,
            "class_weight": "balanced_subsample",
            "n_jobs": -1,
            "random_state": 42
          },
          "strengths": [
            "Highly accurate on complex datasets",
            "Reduces overfitting through averaging",
            "Robust to noise and outliers",
            "Provides feature importance rankings"
          ],
          "weaknesses": [
            "Slower training than single trees",
            "Less interpretable (black box)",
            "Higher memory usage"
          ],
          "use_case": "Best overall performance for fraud detection",
          "algorithm_details": {
            "principle": "Ensemble of decision trees trained on bootstrapped samples",
            "bootstrap_sampling": "Each tree trained on random sample with replacement",
            "feature_randomness": "At each split, consider random subset of features (√n_features)",
            "prediction_aggregation": "Majority vote (classification) or average (regression)",
            "advantages_over_single_tree": [
              "Variance reduction through averaging",
              "Decorrelation of trees via random feature selection",
              "Out-of-bag error estimation for validation"
            ],
            "feature_importance": "Measured by mean decrease in impurity across all trees"
          }
        }
      ],

      "model_selection_process": {
        "description": "Automatic selection of best model based on evaluation metrics",
        "primary_criteria": [
          "Recall (sensitivity) - prioritized for fraud detection",
          "F1 Score - balance of precision and recall"
        ],
        "selection_logic": "Model with highest (recall, f1_score) tuple is selected",
        "rationale": "In fraud detection, catching fraudulent cases (recall) is more important than minimizing false positives"
      }
    },

    "evaluation_metrics": {
      "description": "Comprehensive metrics calculated on held-out test set (20% of data)",
      
      "metrics": [
        {
          "name": "Accuracy",
          "formula": "(TP + TN) / (TP + TN + FP + FN)",
          "interpretation": "Overall correctness, but can be misleading with imbalanced data",
          "typical_range": "95-98% for this project"
        },
        {
          "name": "Precision",
          "formula": "TP / (TP + FP)",
          "interpretation": "Of predicted frauds, how many are actual frauds",
          "importance": "High precision reduces false alarms"
        },
        {
          "name": "Recall (Sensitivity)",
          "formula": "TP / (TP + FN)",
          "interpretation": "Of actual frauds, how many did we catch",
          "importance": "PRIMARY METRIC - Missing fraud is costly",
          "typical_range": "85-95% for this project"
        },
        {
          "name": "F1 Score",
          "formula": "2 × (Precision × Recall) / (Precision + Recall)",
          "interpretation": "Harmonic mean balancing precision and recall",
          "importance": "SECONDARY METRIC for model selection"
        },
        {
          "name": "Balanced Accuracy",
          "formula": "(Sensitivity + Specificity) / 2",
          "interpretation": "Average of recall for each class, handles imbalance well"
        },
        {
          "name": "ROC AUC",
          "formula": "Area under Receiver Operating Characteristic curve",
          "interpretation": "Model's ability to distinguish between classes at various thresholds",
          "range": "0.5 (random) to 1.0 (perfect)",
          "typical_value": "0.96-0.98 for this project"
        },
        {
          "name": "PR AUC",
          "formula": "Area under Precision-Recall curve",
          "interpretation": "Better than ROC for imbalanced datasets",
          "importance": "Shows precision-recall tradeoff"
        },
        {
          "name": "False Positive Rate",
          "formula": "FP / (FP + TN)",
          "interpretation": "Proportion of legitimate cases incorrectly flagged",
          "importance": "Affects user experience and operational cost"
        },
        {
          "name": "Confusion Matrix",
          "structure": "[[TN, FP], [FN, TP]]",
          "interpretation": "Complete breakdown of prediction outcomes"
        }
      ],

      "class_imbalance_handling": {
        "problem": "Fraud is rare (typically <1% of transactions)",
        "solutions_implemented": [
          "class_weight='balanced' - Penalizes mistakes on minority class more heavily",
          "Stratified splitting - Preserves class distribution in train/test sets",
          "Recall-focused model selection - Prioritizes catching fraud over precision",
          "Balanced accuracy metric - Accounts for imbalance in evaluation"
        ]
      }
    }
  },

